#!/usr/bin/env bash
set -e

# Put homebrew, bun, and node on PATH (Husky/git strip non-standard paths).
export PATH="/opt/homebrew/bin:$HOME/.bun/bin:$HOME/.cargo/bin:$PATH"

cd "$(git rev-parse --show-toplevel)"

echo "=== immorterm-mcp-gateway pre-push: build + test ==="

echo "[1/2] Building (tsc)..."
if ! npm run build; then
  echo
  echo "tsc build failed. Fix the type errors, then push again."
  echo "  (emergency bypass: git push --no-verify)"
  exit 1
fi
echo "  build OK"

echo "[2/2] Testing (vitest)..."
if ! npm test; then
  echo
  echo "tests failed. Fix them, then push again."
  echo "  (emergency bypass: git push --no-verify)"
  exit 1
fi
echo "  tests OK"

echo "All checks passed"
